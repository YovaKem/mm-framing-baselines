__pycache__/
*.pyc
venv/
*.egg-info/
.claude/

# Large / regeneratable data artifacts — regenerate via scripts/*.py.
# Kept out of git: raw sample/scrape-attempt-log/scraped-images/consolidated
# rows (large, and full scraped article text may be copyrighted). The
# per-model relabel_*.jsonl and baseline_*.jsonl files hold only labels +
# explanations (no copyrighted text) and ARE tracked, along with flags.json
# and the *_report.md files — they're the actual review/baseline output.
data/*.jsonl
!data/relabel_*.jsonl
!data/baseline_*.jsonl
data/images/*
!data/images/.gitkeep
data/lora_adapters/
data/subtask1_test/
data/subtask1_train/
data/subtask2_test/
data/subtask2_test.zip
data/subtask2_train/
data/subtask2_train.zip

# Local-model venv (torch/transformers/etc.) — regenerate via docs/PIPELINE.md's
# venv setup, not tracked (large, platform-specific wheels).
.venv/

.env
