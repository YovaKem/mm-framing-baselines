__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Large / regeneratable data artifacts — regenerate via scripts/*.py.
# Kept out of git: raw sample/scrape-attempt-log/scraped-images/consolidated
# rows (large, and full scraped article text may be copyrighted). The
# per-model relabel_*.jsonl files hold only labels + explanations (no
# copyrighted text) and ARE tracked, along with validation_results.csv,
# flags.json, and the *_report.md files — they're the actual review output.
data/*.jsonl
!data/relabel_*.jsonl
data/images/*
!data/images/.gitkeep

.streamlit/
.env
